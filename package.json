{
  "name": "dsh-plugin-garmin",
  "version": "0.1.0",
  "description": "Garmin Watch Face Generator & Workbench Plugin for DeepSeek Harness (dsh)",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js",
      "default": "./dist/src/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs => { fs.writeFileSync('dist/index.js', 'export * from \\\"./src/index.js\\\";\\nexport { apply as default } from \\\"./src/index.js\\\";\\n'); fs.writeFileSync('dist/index.d.ts', 'export * from \\\"./src/index.js\\\";\\n'); fs.writeFileSync('dist/client.js', 'export * from \\\"./src/client/index.js\\\";\\nexport { apply as default } from \\\"./src/client/index.js\\\";\\n'); fs.writeFileSync('dist/client.d.ts', 'export * from \\\"./src/client/index.js\\\";\\n'); })\"",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/test/*.js",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist",
    "src/web",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "garmin",
    "connect-iq",
    "monkey-c",
    "fenix7",
    "watchface",
    "generator"
  ],
  "author": "DeepSeek Harness Community",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=3.0.0 || >=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "cordis": ">=3.0.0 || >=4.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^5.8.0"
  }
}
