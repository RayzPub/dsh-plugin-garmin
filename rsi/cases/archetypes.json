[
  {
    "id": "tactical_stealth",
    "name": "Tactical Stealth (战术混合表盘)",
    "template": "tactical",
    "prompt": "设计一款 Garmin Fenix 7 战术风表盘（Tactical Stealth），包含橙色指针、深色背景、电量条、心率和步数弧环。要求先调用 garmin_preview 生成预览，再调用 garmin_scaffold 生成工程。",
    "spec": {
      "name": "TacticalStealth",
      "theme": "tactical",
      "targetDevice": "fenix7",
      "backgroundColor": "#000000",
      "clockType": "hybrid",
      "dial": {
        "showTicks": true,
        "tickColor": "#555555",
        "subTicks": true,
        "showNumbers": true,
        "numberColor": "#FF5500",
        "radius": 120
      },
      "digitalClock": {
        "x": 130,
        "y": 88,
        "font": "NUMBER_HOT",
        "color": "#FFFFFF",
        "showSeconds": true,
        "showAmPm": false
      },
      "analogHands": {
        "hourColor": "#FF5500",
        "minuteColor": "#FF5500",
        "secondColor": "#FF5500",
        "hourLength": 50,
        "minuteLength": 80,
        "secondLength": 95,
        "hourWidth": 4,
        "minuteWidth": 3,
        "secondWidth": 1,
        "accentTail": true
      },
      "complications": [
        { "id": "hr", "type": "heart_rate", "position": { "x": 72, "y": 162 }, "style": "arc_progress", "color": "#FF5500" },
        { "id": "step", "type": "steps", "position": { "x": 188, "y": 162 }, "style": "arc_progress", "color": "#FF5500" },
        { "id": "bat", "type": "battery", "position": { "x": 130, "y": 205 }, "style": "bar_progress", "color": "#FF5500" }
      ]
    },
    "expected": {
      "clockType": "hybrid",
      "mustHaveHands": true,
      "mustHaveDigital": true,
      "requiredComplications": ["heart_rate", "steps", "battery"],
      "mustHaveArcProgress": true,
      "mustHaveBarProgress": true
    }
  },
